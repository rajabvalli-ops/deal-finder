# Copy to .env for local development. Names only — never commit real values.
# Prisma CLI and Next.js both read .env.

# Public base URL of the site, used for canonical URLs and metadata.
# Required in production; defaults to http://localhost:3000 in development and test.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# PostgreSQL connection used by the app at runtime. In production use the provider's
# pooled connection string.
DATABASE_URL=postgresql://dealfinder:dealfinder@localhost:5432/dealfinder

# Optional: direct (unpooled) connection for migrations. Falls back to DATABASE_URL.
# DATABASE_URL_UNPOOLED=

# Integration tests only. They TRUNCATE every table, so the database name must contain "test".
TEST_DATABASE_URL=postgresql://dealfinder:dealfinder@localhost:5432/dealfinder_test

# Bearer token for /api/cron/* (Vercel sends it automatically when set in the project).
# At least 32 characters, e.g. `openssl rand -hex 32`. Unset = cron endpoints return 503.
CRON_SECRET=

# Signs session cookies. Required in production (at least 32 characters, e.g. `openssl rand -hex 32`).
# Optional in development and tests, where a fixed development-only value is used.
BETTER_AUTH_SECRET=
