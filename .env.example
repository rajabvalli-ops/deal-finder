# Copy to .env for local development. Names only — never commit real values.
# Prisma CLI and Next.js both read .env.

# Public base URL of the site, used for canonical URLs and metadata.
# Required in production; defaults to http://localhost:3000 in development and test.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# PostgreSQL connection used by the app at runtime. In production use the provider's
# pooled connection string.
DATABASE_URL=postgresql://dealfinder:dealfinder@localhost:5432/dealfinder

# Optional: direct (unpooled) connection for migrations. Falls back to DATABASE_URL.
# DATABASE_URL_UNPOOLED=

# Integration tests only. They TRUNCATE every table, so the database name must contain "test".
TEST_DATABASE_URL=postgresql://dealfinder:dealfinder@localhost:5432/dealfinder_test

# Bearer token for /api/cron/* (Vercel sends it automatically when set in the project).
# At least 32 characters, e.g. `openssl rand -hex 32`. Unset = cron endpoints return 503.
CRON_SECRET=

# Signs session cookies. Required in production (at least 32 characters, e.g. `openssl rand -hex 32`).
# Optional in development and tests, where a fixed development-only value is used.
BETTER_AUTH_SECRET=

# Amazon UK (Amazon Associates Creators API). From Associates Central → Tools → Creators API
# (only the primary account owner can create credentials; the secret is shown once).
# Leave empty until you have them — Amazon UK stays paused and nothing calls Amazon.
AMAZON_CREATORS_CREDENTIAL_ID=
AMAZON_CREATORS_CREDENTIAL_SECRET=
# The credential's version as shown by Amazon, e.g. 3.2 (Login with Amazon, EU) or 2.2.
AMAZON_CREATORS_CREDENTIAL_VERSION=
# Your Associates tracking ID (UK IDs end in -21). Added to every Amazon link.
AMAZON_ASSOCIATE_TAG=

# Browser push notifications for price alerts. Generate with `npm run push:keys`.
# Empty = push turned off (alerts still appear on the alerts page).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Auto-posting deals to X (the brand account). From developer.x.com: an app with Read and
# write permission; API key/secret plus the account's access token/secret. Empty = no posting.
# X bills per post (much more for posts containing a link) — keep the daily limit modest.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
# Optional: posts per 24 hours (default 10); big-drop | price-error | normal;
# deal-page | amazon (straight to the retailer with your affiliate tag) | none.
# Level and links also apply to "tap to tweet" (no X keys needed; see README).
X_DAILY_POST_LIMIT=
X_POST_MIN_LEVEL=
X_POST_LINKS=
# "App first": minutes a deal waits before it goes to X, so people with notifications hear
# first (default 30; 0 = straight away). Editors' "Post to X now" ignores it.
X_POST_DELAY_MINUTES=
